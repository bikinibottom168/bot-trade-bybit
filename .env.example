# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  cp .env.example .env
#
# 1) สมัคร/ล็อกอิน Bybit Testnet: https://testnet.bybit.com
# 2) ไปที่ API Management สร้าง API key (เลือกสิทธิ์ "Trade" เท่านั้น
#    อย่าเปิดสิทธิ์ Withdraw เด็ดขาด)
# 3) เอา key/secret มาใส่ด้านล่าง

BYBIT_API_KEY=ใส่คีย์ที่นี่
BYBIT_API_SECRET=ใส่ซีเคร็ตที่นี่

# true = เงินปลอม (testnet), false = เงินจริง
TESTNET=true

# true = จำลองอย่างเดียวไม่ส่งคำสั่งจริง, false = ส่งคำสั่งจริง (บน testnet/live)
DRY_RUN=true

# true = มี stop loss กันล้างพอร์ต, false = เลียนแบบข่าว (ไม่มี SL — เสี่ยงมาก)
USE_STOP_LOSS=true
